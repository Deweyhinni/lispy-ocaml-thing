(let meow (s : String) = (print s))

(let meows = (["meow" "mrow" "mjá" "ニャー"]))

(let floats = ([3.14 2.72 6.9 3.141592653589]))

(let nums = ([2001 1984 2000 1 0 -1 -154 3 1024]))

(let units = ([() () () ()]))

(let lone_unit = ([()]))

(let idk =
  let m = (meows)
  in
  (print m)
)

(let add_test = (+ 3 7))

(let float_int_add = let i = 3 let f = 0.14 in (+ i f))

(let arrow_add = (fn (x : Int) -> (fn (y : Int) -> (+ x y))))

(let add3 = (arrow_add 3))

(let list_var = let l = (["hello" "lol"]) in (l))

(let param_types (x : Int) (y : Float) = (+ x y))

(let list_param (l : [[String]]) = (l))

(let conditional (x : Int) (y : Int) = (if (> x y) then x else y))

(let conditional_2 (s1 : String) (s2 : String) = (if (== s1 s2) then "true" else "false"))

(let is_even (x : Float) = (if (== (% x 2.0) (0.0)) then "even" else "odd"))

(let curry_str_concat = (fn (s1 : String) -> (fn (s2 : String) -> (+ s1 s2))))

(let meow_concat = (curry_str_concat "meow"))

(let meow_lol = let lol = "lol" in (meow_concat lol))

(let double_meow_lol = let lol = "lol" in (meow_concat (meow_concat lol)))

(let double_lol_meow = let lol = "lol" in (curry_str_concat (lol) (meow_concat lol)))

(let str_concat (s1 : String) (s2 : String) = (+ s1 s2))

(let () = (meow "hello"))
