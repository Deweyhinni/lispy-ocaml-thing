(let conditional (x : Int) (y : Int) = (if (> x y) then x else y))

(let conditional_2 (s1 : String) (s2 : String) = (if (== s1 s2) then "true" else "false"))

(let is_even (x : Float) = (if (== (% x 2.0) (0.0)) then "even" else "odd"))

